{
  "schema_version": 1,
  "subset_id": "controlled180",
  "source_dataset": "levels/extended",
  "source_puzzle_count": 1000,
  "puzzle_count": 180,
  "selection_quota_by_difficulty": {
    "easy": 60,
    "medium": 60,
    "hard": 60
  },
  "selection_method": {
    "description": "Select without model outcomes. Take 60 puzzles from each difficulty under the labels available during selection, require rare-mechanism and car-count/mechanism-count bin coverage, then maximize coverage and diversity within each difficulty. Mechanisms overlap; their counts are not equal-size exclusive groups.",
    "algorithm": "Deterministic greedy selection followed by best improving one-for-one exchanges within each difficulty. During greedy selection, first maximize the number of still-unfilled required coverage slots filled by the next puzzle; break ties by the stated score. Once coverage floors are filled, maximize the stated score. An exchange must preserve every required coverage minimum. Stop when no one-for-one exchange improves the stated score.",
    "primary_mechanisms": [
      "tunnels",
      "switches_and_gates",
      "self_switching_junctions",
      "passenger_stations",
      "post_offices",
      "semaphores",
      "multiple_trains",
      "decoy_cars"
    ],
    "constant_mechanism_excluded": "junctions: the dataset helper includes every puzzle with a positive track budget, so this label is constant in the source corpus.",
    "rare_mechanism_minimum": "For each difficulty and primary mechanism: min(4, the number of candidates containing that mechanism). These are coverage floors, not claims of equal mechanism frequencies.",
    "required_diversity_bin_coverage": "Within each difficulty, select at least one puzzle from every car-count bin (1,2,3,4,>=5) and every nonconstant-mechanism-count bin (0,1,2,3,>=4) that exists among the candidates. These requirements and the rare-mechanism floors are hard constraints. Area, track-budget, execution-length and obstacle bins remain soft diversity objectives.",
    "objective_weights": {
      "mechanisms": 0.35,
      "combinations": 0.25,
      "diversity": 0.25,
      "layouts": 0.15
    },
    "objective_definitions": {
      "mechanisms": "Mean over eight mechanisms of log(1+selected count) / log(1+min(quota,available count)).",
      "combinations": "Sum of square roots of counts of exact primary-mechanism combinations, divided by sqrt(quota*min(quota,available combination count)).",
      "diversity": "For each of the six recorded diversity dimensions, mean sqrt(selected bin count/min(quota,available bin count)); then average the six dimension scores.",
      "layouts": "Number of represented layout components divided by min(quota,available layout component count)."
    },
    "diversity_bins": {
      "board_area": [
        "<=16",
        "17-25",
        "26-36",
        "37-49",
        ">=50"
      ],
      "cars": [
        "1",
        "2",
        "3",
        "4",
        ">=5"
      ],
      "available_tracks": [
        "<=4",
        "5-8",
        "9-12",
        "13-16",
        "17-20",
        ">=21"
      ],
      "reference_execution_ticks": [
        "<=10",
        "11-20",
        "21-40",
        "41-80",
        ">=81"
      ],
      "obstacles": [
        "absent",
        "present"
      ],
      "nonconstant_mechanism_count": [
        "0",
        "1",
        "2",
        "3",
        ">=4"
      ]
    },
    "feature_sources": "Derive mechanisms, area, cars, track budget, blocked cells and fine features directly from puzzle contents. Execution ticks come from saved reference metadata.simulation_steps; they describe game execution, not search or model reasoning.",
    "blocked_cells": "Board code 4 and station-building codes 34-37 are the same blocked category.",
    "layout_comparison": "Compare cropped initial railway scaffolds directly under all rotations and reflections. Rail cells retain endpoint directions; tunnels and locomotive types retain directions; modifier types, passenger/post-office numbers and normalized button/tunnel link groups are retained. Car-start markers, car order/position and track budgets do not separate scaffold groups. Crop only empty borders. Connect two scaffolds with the same dimensions and locomotive-type counts when at most max(1,floor(0.08*area)) cell records differ; use connected components as a soft concentration penalty. Components measure approximate similarity, not gameplay equivalence.",
    "fine_feature_definitions": {
      "buttons": "Modifier 1.",
      "gates": "Modifiers 3 or 4; initial open/closed states are also counted separately.",
      "button_switched_junctions": "Modifier 5.",
      "initial_ordinary_junctions": "Initial board codes 9-16 whose modifier is neither 5 nor 7.",
      "initial_semaphores": "Modifier 8.",
      "placeable_semaphore_budget": "Positive puzzle semaphore budget; total records the sum of these budgets."
    },
    "deterministic_ties": "Compare objective values rounded to 12 decimal places. Candidate order uses mechanism tuple, diversity-bin tuple, area, cars, track budget, execution ticks, directly compared scaffold tuples, and level ID. No random seed, content digest or model outcome is used.",
    "interpretation": "The puzzle IDs are fixed independently of model outcomes. selection_quota_by_difficulty records the per-difficulty targets used during selection; statistics reports the released difficulty labels (60 easy, 59 medium, 61 hard) and coverage. This panel emphasizes mechanism and difficulty coverage and does not estimate full-corpus accuracy."
  },
